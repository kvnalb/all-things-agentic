# Non-secret configuration only. Provider tokens are collected by the setup
# wizard and persisted in Google Secret Manager.
STUDYAGENT_ENV=development
STUDYAGENT_ALLOWED_EMAIL=you@example.com
GOOGLE_CLOUD_PROJECT=studyagent-fall26-example
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
STUDYAGENT_GEMINI_MODEL=gemini-3.5-flash
# Voice Q&A uses Gemini Omni via the Interactions API (text-only modality).
STUDYAGENT_VOICE_MODEL=gemini-omni-1.1-flash-preview
STUDYAGENT_SOURCE_BUCKET=your-private-source-bucket
STUDYAGENT_BASE_URL=http://localhost:8080
# Set to "demo" to load demo/data/deadlines.db instead of live Canvas/syllabus ingestion.
STUDYAGENT_DATA_SOURCE=live
# Optional override for the demo SQLite database path.
# STUDYAGENT_DEMO_DB=/absolute/path/to/deadlines.db
CANVAS_BASE_URL=https://bcourses.berkeley.edu
